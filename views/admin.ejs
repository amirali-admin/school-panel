<!doctype html><html lang="fa"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>پنل مدیریت</title><link rel="stylesheet" href="/style.css"></head><body><nav class="nav"><a class="brand" href="/"><span class="logo">م</span>پنل مدیریت</a><div class="navlinks"><span>مدیر: <b><%= user.name %></b></span><form method="post" action="/logout"><button class="btn light">خروج</button></form></div></nav><main class="dash"><div class="container"><span class="eyebrow">مدیریت کامل سامانه</span><h1>داشبورد مدیر</h1><div class="stats"><div class="stat"><span class="muted">کاربران</span><b><%= users.length %></b></div><div class="stat"><span class="muted">دانش‌آموزان</span><b><%= users.filter(u=>u.role==='student').length %></b></div><div class="stat"><span class="muted">نمرات</span><b><%= grades.length %></b></div><div class="stat"><span class="muted">اطلاعیه‌ها</span><b><%= notices.length %></b></div></div>
<div class="grid2"><div class="panel"><h2>افزودن کاربر</h2><form method="post" action="/admin/users"><div class="field"><label>نام</label><input name="name" required></div><div class="field"><label>نام کاربری</label><input name="username" required></div><div class="field"><label>رمز عبور</label><input name="password" type="password" required></div><div class="field"><label>نوع کاربر</label><select name="role"><option value="student">دانش‌آموز</option><option value="admin">مدیر</option></select></div><div class="field"><label>کلاس</label><input name="class_name" placeholder="مثلاً دهم الف"></div><button class="btn">ایجاد کاربر</button></form></div>
<div class="panel"><h2>ثبت نمره</h2><form method="post" action="/admin/grades"><div class="field"><label>دانش‌آموز</label><select name="user_id" required><% users.filter(u=>u.role==='student').forEach(u=>{ %><option value="<%=u.id%>"><%=u.name%> — <%=u.username%></option><% }) %></select></div><div class="field"><label>درس</label><input name="subject" required></div><div class="field"><label>نمره</label><input name="score" type="number" step="0.01" min="0" required></div><div class="field"><label>از</label><input name="max_score" type="number" step="0.01" value="20"></div><div class="field"><label>توضیح</label><input name="note"></div><button class="btn">ثبت نمره</button></form></div></div>
<div class="panel"><h2>کاربران</h2><div class="table-wrap"><table class="table"><tr><th>نام</th><th>نام کاربری</th><th>نقش</th><th>کلاس</th><th>عملیات</th></tr><% users.forEach(u=>{ %><tr><td><%=u.name%></td><td><%=u.username%></td><td><%=u.role==='admin'?'مدیر':'دانش‌آموز'%></td><td><%=u.class_name||'—'%></td><td><% if(u.id!==user.id){ %><form method="post" action="/admin/users/<%=u.id%>/delete" style="display:inline"><button class="btn danger">حذف</button></form><% }else{ %>حساب فعلی<% } %></td></tr><% }) %></table></div></div>
<div class="panel"><h2>مدیریت نمرات</h2><div class="table-wrap"><table class="table"><tr><th>دانش‌آموز</th><th>درس</th><th>نمره</th><th>عملیات</th></tr><% grades.forEach(g=>{ %><tr><td><%=g.student_name%></td><td><%=g.subject%></td><td><%=g.score%>/<%=g.max_score%></td><td><form method="post" action="/admin/grades/<%=g.id%>/delete"><button class="btn danger">حذف</button></form></td></tr><% }) %></table></div></div>
<div class="grid2"><div class="panel"><h2>افزودن اطلاعیه</h2><form method="post" action="/admin/notices"><div class="field"><label>عنوان</label><input name="title" required></div><div class="field"><label>متن</label><textarea name="body" required></textarea></div><div class="field"><label>برچسب</label><input name="tag" value="اطلاعیه"></div><button class="btn">انتشار اطلاعیه</button></form><hr><% notices.forEach(n=>{ %><p><b><%=n.title%></b> <form style="display:inline" method="post" action="/admin/notices/<%=n.id%>/delete"><button class="btn danger">حذف</button></form></p><% }) %></div>
<div class="panel"><h2>افزودن تابلو</h2><form method="post" action="/admin/boards"><div class="field"><label>عنوان</label><input name="title" required></div><div class="field"><label>متن</label><textarea name="body" required></textarea></div><div class="field"><label>متن دکمه</label><input name="button_text"></div><div class="field"><label>لینک دکمه</label><input name="button_url" placeholder="/login"></div><button class="btn">افزودن به تابلو</button></form><hr><% boards.forEach(b=>{ %><p><b><%=b.title%></b> <form style="display:inline" method="post" action="/admin/boards/<%=b.id%>/delete"><button class="btn danger">حذف</button></form></p><% }) %></div></div>
</div></main></body></html>
