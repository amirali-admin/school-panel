<!doctype html><html lang="fa"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>پنل دانش‌آموز</title><link rel="stylesheet" href="/style.css"></head><body><nav class="nav"><a class="brand" href="/"><span class="logo">م</span>پنل دانش‌آموز</a><form method="post" action="/logout"><button class="btn light">خروج</button></form></nav><main class="dash"><div class="container"><div class="dash-top"><div><span class="eyebrow">خوش آمدید</span><h1 style="margin:10px 0"><%= user.name %></h1><div class="muted"><%= user.class_name || 'دانش‌آموز' %></div></div></div><div class="stats"><div class="stat"><span class="muted">میانگین نمرات</span><b><%= avg %></b></div><div class="stat"><span class="muted">تعداد نمرات</span><b><%= grades.length %></b></div><div class="stat"><span class="muted">نقش</span><b style="font-size:19px">دانش‌آموز</b></div><div class="stat"><span class="muted">نام کاربری</span><b style="font-size:19px"><%= user.username %></b></div></div><div class="panel"><h2>کارنامه و نمرات</h2><div class="table-wrap"><table class="table"><thead><tr><th>درس</th><th>نمره</th><th>از</th><th>توضیح</th></tr></thead><tbody><% grades.forEach(g=>{ %><tr><td><%= g.subject %></td><td><b><%= g.score %></b></td><td><%= g.max_score %></td><td><%= g.note || '—' %></td></tr><% }) %><% if(!grades.length){ %><tr><td colspan="4">هنوز نمره‌ای ثبت نشده است.</td></tr><% } %></tbody></table></div></div><div class="panel"><h2>اطلاعیه‌های اخیر</h2><div class="cards"><% notices.forEach(n=>{ %><div class="card"><span class="tag"><%= n.tag %></span><h3><%= n.title %></h3><p class="muted"><%= n.body %></p></div><% }) %></div></div></div></main></body></html>
