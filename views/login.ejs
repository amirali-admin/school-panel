<!doctype html><html lang="fa"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ورود به سامانه</title><link rel="stylesheet" href="/style.css"></head><body><nav class="nav"><a class="brand" href="/"><span class="logo">م</span>سامانه هوشمند مدرسه</a><a href="/">صفحه اصلی</a></nav><main class="login-wrap"><form class="login-box" method="post" action="/login"><span class="eyebrow">ورود امن</span><h1 style="margin-bottom:6px">ورود به پنل</h1><p class="muted">نام کاربری و رمز عبور خود را وارد کنید.</p><% if(error){ %><div class="alert"><%= error %></div><% } %><div class="field"><label>نام کاربری</label><input name="username" required autocomplete="username"></div><div class="field"><label>رمز عبور</label><input type="password" name="password" required autocomplete="current-password"></div><button class="btn" style="width:100%;margin-top:8px">ورود</button><a class="btn light" style="width:100%;text-align:center;margin-top:10px" href="/">بازگشت</a></form></main></body></html>
